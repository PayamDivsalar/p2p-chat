# Environment template file
# Copy this to .env and configure values

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# STUN Server Configuration
STUN_SERVER_HOST=0.0.0.0
STUN_SERVER_PORT=8000

# Storage Backend: 'memory' for in-memory storage, 'redis' for Redis
STORAGE_BACKEND=redis
